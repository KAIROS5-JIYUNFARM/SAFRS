Panels:
  - Class: rviz_common/Displays
    Name: Displays

  - Class: rviz_common/Selection
    Name: Selection

  - Class: rviz_common/ToolProperties
    Name: Tool Properties

  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Name: root
  Class: ""
  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.25
      Update Interval: 0.0

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Queue Size: 10
      Style: Points
      Size (m): 0.03
      Alpha: 1.0
      Color Transformer: Intensity
      Autocompute Intensity Bounds: true

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Pitch: 0.7
      Yaw: 0.6
