<?xml version="1.0"?>
<robot name="minimal_robot">

  <!-- Base Footprint -->
  <link name="base_footprint"/>

  <!-- Base Link (차체 중심) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.5 0.35 0.09"/> <!-- 차체 크기 -->
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
  </link>

  <!-- base_footprint → base_link -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.072909" rpy="0 0 0"/>
  </joint>

  <!-- Laser Link -->
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.04"/> <!-- 라이다 단순 형상 -->
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1.0"/>
      </material>
    </visual>
  </link>

  <!-- base_link → laser_frame -->
  <joint name="base_link_to_laser_frame" type="fixed">
    <parent link="base_link"/>
    <child link="laser_frame"/>
    <origin xyz="0.175093 0 0.05535" rpy="0 0 0"/>
  </joint>

</robot>
