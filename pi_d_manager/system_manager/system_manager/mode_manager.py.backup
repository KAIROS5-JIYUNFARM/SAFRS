#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from rclpy.time import Time

from geometry_msgs.msg import Twist
from system_interfaces.msg import SystemMode, Detect, EndSignal, TriggerCmd


class ModeManager(Node):
    def __init__(self):
        super().__init__('mode_manager')

        # =========================
        # State
        # =========================
        self.current_mode = 'STANDBY'
        self.last_cmd_vel_time = self.get_clock().now()
        self.last_event_time = self.get_clock().now()

        # =========================
        # Publishers
        # =========================
        self.mode_pub = self.create_publisher(SystemMode, '/system_mode', 10)
        self.trigger_pub = self.create_publisher(TriggerCmd, '/trigger_cmd', 10)

        # =========================
        # Subscribers
        # =========================
        self.create_subscription(Twist, '/cmd_vel', self.cb_cmd_vel, 10)
        self.create_subscription(Detect, '/detect', self.cb_detect, 10)
        self.create_subscription(EndSignal, '/end', self.cb_end, 10)

        # =========================
        # Timer (10 Hz)
        # =========================
        self.timer = self.create_timer(0.1, self.update)

        self.publish_mode('STANDBY')
        self.get_logger().info('ModeManager started in STANDBY')

    # =========================
    # Callbacks
    # =========================
    def cb_cmd_vel(self, msg: Twist):
        self.last_cmd_vel_time = self.get_clock().now()
        if self.current_mode == 'STANDBY':
            self.publish_mode('NAVI')

    def cb_detect(self, msg: Detect):
        self.last_event_time = self.get_clock().now()

        if msg.label.upper() == 'ALLY':
            self.publish_mode('TRACK_ALLY')
        elif msg.label.upper() == 'ENEMY':
            self.publish_mode('TRACK_ENEMY')

    def cb_end(self, msg: EndSignal):
        if not msg.end:
            return

        self.last_event_time = self.get_clock().now()

        if self.current_mode == 'TRACK_ALLY':
            self.get_logger().info('TRACK_ALLY ended → stay')
            self.publish_mode('STANDBY')

        elif self.current_mode == 'TRACK_ENEMY':
            self.get_logger().warn('TRACK_ENEMY ended → FIRE')
            fire = TriggerCmd()
            fire.fire = True
            self.trigger_pub.publish(fire)
            self.publish_mode('STANDBY')

    # =========================
    # Main Update Loop
    # =========================
    def update(self):
        now = self.get_clock().now()

        # 1) cmd_vel timeout → STANDBY
        if self.current_mode == 'NAVI':
            if (now - self.last_cmd_vel_time).nanoseconds > 15e9:
                self.get_logger().warn('cmd_vel timeout → STANDBY')
                self.publish_mode('STANDBY')

        # 2) STANDBY 유지 5초 → NAVI
        if self.current_mode == 'STANDBY':
            if (now - self.last_event_time).nanoseconds > 5e9:
                self.publish_mode('NAVI')

    # =========================
    # Utils
    # =========================
    def publish_mode(self, mode: str):
        if mode == self.current_mode:
            return

        self.current_mode = mode
        msg = SystemMode()
        msg.mode = mode
        self.mode_pub.publish(msg)

        self.last_event_time = self.get_clock().now()
        self.get_logger().info(f'== MODE → {mode} ==')


def main(args=None):
    rclpy.init(args=args)
    node = ModeManager()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()

